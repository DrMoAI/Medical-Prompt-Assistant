# Copy this file to ".env" and edit. The .env file is private and is never committed.

# Which model to use:
#   auto    = use the paid API if a key is set, otherwise fall back to local Ollama (recommended)
#   api     = paid API only
#   ollama  = local Ollama only (free, private, nothing leaves your computer)
LLM_PROVIDER=auto

# Paid API (leave the key empty to use only Ollama)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Local Ollama
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
